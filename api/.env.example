# nagara / api — every setting the API reads, with its default.
#
# Copy to `api/.env` for local work. `.env` is gitignored; this file is not, and it
# is the canonical list of names. Two rules make it load-bearing:
#
#   1. Every setting is read through `Settings` in `app/config.py` with the
#      `NAGARA_` prefix. Nothing reads an ambient, unprefixed environment variable,
#      even where a vendor SDK would happily do so. See the credentials section.
#   2. `railway.toml` carries no environment variables at all, so production values
#      are Railway dashboard variables. A new credential must be set there BEFORE
#      the merge that needs it, or the deploy boots and every request fails on a
#      missing key.
#
# A name in this file is a name a deploy depends on. Renaming one is a production
# change, not a refactor.


# ── Auth ───────────────────────────────────────────────────────────────────────
# The single key every item route requires (invariant 4). `/health` is the only
# unauthenticated route.
NAGARA_API_KEY=dev-key-nagara


# ── Storage paths ──────────────────────────────────────────────────────────────
# Where the SQLite database and generated audio live when S3 is not configured.
# Defaults to `api/data/`.
# NAGARA_DATA_DIR=

# Left empty, it derives `sqlite:///$NAGARA_DATA_DIR/nagara.db`.
# A managed Postgres `postgres://` URL is normalized to `postgresql://`.
#
# This is the LOGICAL, sync-dialect URL and both consumers need it that way:
# Alembic drives psycopg2 from it directly, and the runtime maps it onto the
# matching async driver (asyncpg for Postgres, aiosqlite for SQLite). Both drivers
# are therefore load-bearing; neither is dead weight to be cleaned up.
# NAGARA_DATABASE_URL=


# ── TTS (Modal) ────────────────────────────────────────────────────────────────
# The deployed Modal app and class the API spawns remotely. The API never imports
# the TTS code (invariant 5).
# NAGARA_MODAL_APP=nagara-tts
# NAGARA_MODAL_CLS=Kokoro


# ── Object storage ─────────────────────────────────────────────────────────────
# Audio, and later images, live in an S3-compatible bucket in production and on
# local disk otherwise. Which backend is a question about configuration, never an
# environment name (invariant 6): all four of endpoint/bucket/key/secret must be
# present or the whole set counts as NOT configured and local storage is used.
# A half-supplied set falls back visibly rather than crashing obscurely.
# NAGARA_S3_ENDPOINT=
# NAGARA_S3_BUCKET=
# NAGARA_S3_ACCESS_KEY_ID=
# NAGARA_S3_SECRET_ACCESS_KEY=
# NAGARA_S3_REGION=auto
# NAGARA_S3_URL_TTL=3600
# Railway buckets use virtual-hosted-style URLs; some stores need "path".
# NAGARA_S3_ADDRESSING_STYLE=virtual


# ── Queue and retry bounds ─────────────────────────────────────────────────────
# How long a `queued` item may sit before poll fails it, measured from `queued_at`
# (which is rewritten on every retry, so it cannot be `created_at`). The ceiling is
# only defensible because enrichment is concurrent: the corpus worst case is ~91
# describable units, which finishes in ~34s at the describe cap.
# NAGARA_QUEUED_CEILING_SECONDS=300
# Retry requires `failed` AND retry_count below this; past it, retry returns 409.
# NAGARA_RETRY_MAX=3


# ── Image fetch bounds ────────────────────────────────────────────────────────
# Image fetches hit arbitrary third-party hosts, so the per-host bound is the one
# with teeth: one article's 27 same-host images must never open 27 connections to
# a server nagara has no relationship with.
# NAGARA_IMAGE_FETCH_PER_HOST=2
# NAGARA_IMAGE_FETCH_CONCURRENCY=10


# ── Fallback fetch (Firecrawl) ────────────────────────────────────────────────
# The fallback fetch when a plain fetch fails or returns too little. Optional: left
# empty, the plain fetch runs alone and a thin or failed extraction stays as it was
# — no second opinion, no new failure. Pass it explicitly from Settings into the SDK;
# do not rely on the SDK reading a bare ambient `FIRECRAWL_API_KEY`, whose name skips
# this project's `NAGARA_` prefix and would put the one key outside Settings.
#
# A guarded page bills far more than the documented 5x and the multiplier is not
# predictable from proxy mode: an X status URL bills 30 while reporting
# `proxyUsed: "basic"`. Set it in the Railway dashboard BEFORE the merge that needs
# it, or every escalating enqueue fails on a missing key.
# NAGARA_FIRECRAWL_API_KEY=


# ── Cost-ledger prices ─────────────────────────────────────────────────────────
# One cost_entries row per metered event snapshots `dollars` at write time from these
# rates, never recomputed, so a later rate change never rewrites history. All are plan-
# or vendor-dependent estimates: set them to your actual tier. firecrawl is per credit
# (proxy="auto" bills 1 on basic, 5 on stealth, more on a guarded page), gemini is per
# describer call, tts is per audio-second.
# NAGARA_FIRECRAWL_DOLLARS_PER_CREDIT=0.005
# NAGARA_GEMINI_DOLLARS_PER_CALL=0.0003
# NAGARA_TTS_DOLLARS_PER_SECOND=0.000015


# ═══════════════════════════════════════════════════════════════════════════════
# NOT YET READ BY THE CODE — reserved names for the richer-extraction raid.
#
# Listed here so the names are fixed before the code that reads them exists, and
# so nobody picks a different one later. Each is named in its own quest under
# docs/quest-log/. Set the credentials in the Railway dashboard BEFORE merging the
# quest that introduces them.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Gemini: the describer ──────────────────────────────────────────────────────
# Needed by: describe-code-blocks, then describe-article-images.
#
# `gemini-3.5-flash-lite` called directly on Google's paid API, with
# `gemini-3.1-flash-lite` as the documented fallback. Not through a gateway: the
# bake-off used OpenRouter only to compare candidates with one key.
#
# Same rule as firecrawl, and it matters more here because `google-genai` reads
# BOTH `GOOGLE_API_KEY` and `GEMINI_API_KEY` ambiently — so a missing setting can
# silently succeed on a developer's machine and fail in production. Pass it
# explicitly from Settings.
# NAGARA_GEMINI_API_KEY=

# ── Enrichment bounds ──────────────────────────────────────────────────────────
# Needed by: describe-code-blocks.
#
# Describer fan-out. Low-stakes: coroutines yield on I/O and the model's RPM is not
# binding at nagara's scale.
# NAGARA_DESCRIBE_CONCURRENCY=10
#
# Per-item ceiling on describer INVOCATIONS, counting units that reach the
# generator after the caption/alt precedence skips. One combined budget for code
# and images. Past it, units fall to their non-describer spoken form in document
# order: the cap degrades, it never fails an item and never goes silent. 25 sits
# just above the point where a code-heavy article's spend falls back to the TTS
# baseline, while still absorbing a 50-image gallery.
# NAGARA_DESCRIBE_MAX_PER_ITEM=25
