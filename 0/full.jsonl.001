"],\"priority\":{\"value\":3,\"name\":\"Medium\"}},{\"id\":\"ASE-14\",\"title\":\"API hardening: quota, GET /items, API-key create and revoke\",\"status\":\"Backlog\",\"projectMilestone\":null,\"labels\":[\"Feature\"],\"priority\":{\"value\":2,\"name\":\"High\"}},{\"id\":\"ASE-11\",\"title\":\"Google OAuth login with pasted-URL stash and replay\",\"status\":\"Backlog\",\"projectMilestone\":{\"id\":\"dec22a7f-5f2d-4690-bc1c-60c6c84a1156\",\"name\":\"Validate demand\"},\"labels\":[\"Feature\"],\"priority\":{\"value\":3,\"name\":\"Medium\"}}],\"hasNextPage\":false}"}],"serverClassifierContext":{"request":"5827a1d8-cca5-46b7-9b7b-a9c7a4e0fbb8","context":{"git_state":{"cwd":"/home/agus/workspace/asermax/nagara","root":"/home/agus/workspace/asermax/nagara","branch":"feat/cloudflare-migration","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"asermax/nagara","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"asermax/nagara","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"asermax/nagara","visibility":"public"},{"host":"github.com","remote":"filadd/cc-plugin-marketplace","visibility":"private"}]}},"live_cwd":"/home/agus/workspace/asermax/nagara","platform":"linux"}},"mcpMeta":{"_meta":{"io.modelcontextprotocol/serverInfo":{"name":"Linear MCP","title":"Linear","icons":[{"src":"https://static.linear.app/integrations/mcp/icon.svg","mimeType":"image/svg+xml"}],"version":"1.0.0","websiteUrl":"https://linear.app"}}},"sourceToolAssistantUUID":"21c74544-1d9f-40ff-9ec6-a4e54aa1a893","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"f14bad90-e61e-4c27-a38f-bf7cbc76465e","userType":"external","entrypoint":"cli","cwd":"/home/agus/workspace/asermax/nagara","sessionId":"f14bad90-e61e-4c27-a38f-bf7cbc76465e","version":"2.1.296","gitBranch":"feat/cloudflare-migration","slug":"atomic-stirring-rossum"}
{"type":"last-prompt","lastPrompt":"those looks good","leafUuid":"a4d897b8-daea-4e0b-af2e-af98ffa0db6d","sessionId":"f14bad90-e61e-4c27-a38f-bf7cbc76465e"}
{"type":"ai-title","aiTitle":"Nagara API migration to Cloudflare","sessionId":"f14bad90-e61e-4c27-a38f-bf7cbc76465e"}
{"type":"mode","mode":"normal","sessionId":"f14bad90-e61e-4c27-a38f-bf7cbc76465e"}
{"type":"permission-mode","permissionMode":"auto","sessionId":"f14bad90-e61e-4c27-a38f-bf7cbc76465e"}
{"type":"atis-latch","atis":"","sessionId":"f14bad90-e61e-4c27-a38f-bf7cbc76465e"}
{"parentUuid":"9c81ff1d-c3d6-43b8-9ed5-d878669916ce","isSidechain":false,"promptId":"575305f9-8090-45cc-a43d-85b00eaf756a","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UDn4JvT1sGceoSDDhF3nUt","type":"tool_result","content":[{"type":"text","text":"{\"milestones\":[{\"id\":\"cb9c8236-7ea7-404c-b9b6-641d87b398d3\",\"name\":\"Extraction v2\",\"description\":\"Extraction that can be trusted and extended per site. A generic base extraction plus declarative per-domain recipes (substack, medium and similar behave the same once described), an agent loop that writes a recipe for an unknown site, auto-validation gates that fail an item whose extraction is not the article before anyone has to report it, and a per-recipe fetch strategy (direct fetch with a browser user agent, firecrawl, or a real browser) with firecrawl kept as a pluggable backend.\\n\\nBuild order: validation gates, then recipe schema and resolver, then the agent recipe loop, then fetch pluggability, then a reporting UI only if still needed. Paywalled credentials are deferred, possibly forever.\\n\\nThis replaces an earlier plan that put an LLM in the extraction hot path (firecrawl always, HTML always, an LLM instead of trafilatura, with a prompt eval system). The recipes approach keeps per-request extraction deterministic and moves the intelligence to authoring time.\\n\\n**Closed on 2026-10-04.** What shipped: the recipe runtime that runs a stored script deterministically ([ASE-6](https://linear.app/asermax/issue/ASE-6/recipe-runtime-deterministic-execution-behind-run-and-validate)), the Flue authoring and revision agents ([ASE-7](https://linear.app/asermax/issue/ASE-7/agents-authoring-and-revision-loops-on-flue)), the extraction service on Cloudflare ([ASE-61](https://linear.app/asermax/issue/ASE-61/extraction-service-the-pipeline-deployable-on-cloudflare)) and the API's integration with it ([ASE-63](https://linear.app/asermax/issue/ASE-63/api-integration-extraction-client-handle-and-the-recipe-version)); trafilatura is retired. What was dropped: the validation gates ([ASE-5](https://linear.app/asermax/issue/ASE-5/validation-gates-fail-an-item-whose-extraction-is-not-the-article), [ASE-24](https://linear.app/asermax/issue/ASE-24/can-a-ready-item-be-trusted-to-be-the-article-it-claims-to-be)), replaced by the validator plus the agents' not-an-article verdict, and the per-recipe fetch strategy ([ASE-8](https://linear.app/asermax/issue/ASE-8/per-recipe-fetch-strategy-direct-firecrawl-or-browser)), firecrawl staying the one fetch behind the `Fetcher` interface. The defects found afterwards on real articles moved to the Extraction issues milestone; the trafilatura-era bugs that recipes made moot ([ASE-25](https://linear.app/asermax/issue/ASE-25/unfenced-repl-and-code-inside-prose-paragraphs-is-spoken-as-prose), [ASE-26](https://linear.app/asermax/issue/ASE-26/strip-prose-boilerplate-footer-donation-and-sponsor-paragraphs)) were canceled. The reporting UI ([ASE-9](https://linear.app/asermax/issue/ASE-9/bad-extraction-reporting-ui-if-still-needed)) moved out with the web surfaces.\",\"progress\":100,\"sortOrder\":53},{\"id\":\"8f6c74e7-9314-4d0e-b5c8-fd144f08a8b0\",\"name\":\"Markdown and lists\",\"description\":\"Improve what the extraction and TTS pipeline outputs, from both ends: the markdown a recipe extracts, and how that markdown is read aloud.\\n\\n* Markdown fidelity: recipes extract real structure (blockquotes when the text is a quote, headings, lists) instead of flattening everything to plain paragraphs. Verified with a synthetic article that exercises every markdown element, run through each recipe; the structure must come out intact.\\n* Lists in audio: a list is currently read as one paragraph with no breaks. Each item becomes its own unit or chunk, so the TTS delivers it as a list rather than a run-on paragraph.\\n\\nTo be shaped and designed before tasks are written.\",\"progress\":100,\"sortOrder\":515.32},{\"id\":\"1f715c70-f21d-466d-92a3-ef263db6955e\",\"name\":\"Cloudflare migration\",\"description\":\"Move the rest of nagara onto Cloudflare, so the recipe logic and the articles extracted with older recipes live in one place. The extraction pipeline already runs on Cloudflare (`pipeline/`); what else moves is not settled yet.\\n\\nRecipe reconciliation depends on this milestone.\\n\\nTo be shaped and designed before tasks are written.\",\"progress\":0,\"sortOrder\":753.8},{\"id\":\"4232272a-96de-4304-8664-688c8187dafd\",\"name\":\"Read-along player\",\"description\":\"A web surface at `web/` where an item's audio and its text are read together, the text following the audio closely enough that listening while reading is one activity rather than two. One player with two reading modes: a calm scroll-normal reader by default, and an opt-in focus mode that centres and enlarges the active paragraph. It consumes the existing item contract unchanged: no per-unit `type` field, no word-level timing, nothing in `api/` or `tts/`. Done means the surface is built, deployed and dogfooded on real generated items, with its mechanism recorded as a note in `docs/technical-design/`.\\n\\nDecisions settled by the spike, which is preserved on the unmerged `idea/read-along-player` branch with its tree relocated to `web/`:\\n\\n* The stack is TanStack Start with Panda-CSS. The build is a rewrite of the spike, not a merge.\\n* A dark immersive shell with a heading-derived floating table of contents, a floating transport and a progress bar.\\n* Scroll-decoupled navigation: a seek-to-here follow pill, ±10 s skip, and resume. No click-to-seek.\\n* Highlight sync runs off `requestAnimationFrame` polling `currentTime`, never `timeupdate`. Measured lag was 19 to 26 ms against a 200 ms budget, re-locking immediately after a seek.\\n* Two things from the spike must not be copied: its global `ka-*` CSS class names, which leaked between components once, and its localStorage resume, which is a stand-in rather than a decision.\\n\\nRead first: `docs/product-design/listening-experience.md`, `docs/technical-design/read-along-timing.md` (timing mechanism and the seek nudge), `docs/technical-design/item-contract.md`, and `docs/technical-design/invariants.md` for the sync budget.\\n\\nOpen questions, each blocking a slice rather than the whole build: how lists, code and tables behave in focus mode, since centring and enlarging breaks their left-aligned structure; whether blockquote and table render and highlight correctly, since the spike's probe for them was never built; whether the mobile breakpoint holds on a real device; whether resume needs a server-side position to follow a listener across devices; how an image unit renders without being treated as prose.\\n\\nThe shape evidence is builder-confounded: the same person built and judged the spike on two real articles. It validates shape, UX and the functional contract, not demand or a fresh user's experience; those belong to the demand-validation work.\\n\\nOut of scope: visual design (typography, colour, motion and brand feel are a separate milestone that treats this layout as fixed; the spike's placeholder aesthetic carries no verdict weight); click-to-seek (whether its absence is felt as friction by anyone other than the builder is a demand question); word-level highlighting (the contract is paragraph-level and nothing needed finer); caption export, which maps the same timing windows onto cue timings and is its own issue.\",\"progress\":25,\"sortOrder\":806.12},{\"id\":\"5d1d2f53-65e7-4600-bb34-bcd3bbd183b7\",\"name\":\"Read-along visual design\",\"description\":\"A proper visual design for the read-along player and, by extension, the web surface: a design language, typography, colour, motion, and light and dark modes, coherent enough that a stranger reads it as a finished product. Judged on aesthetic coherence and quality against real long-form articles rather than sample text, because sustained prose is where typography either works or does not.\\n\\nAlready settled and not up for redesign: the player's layout, navigation and structure. The shape work fixed one player with a calm scroll-normal default and an opt-in focus mode, inside a dark immersive shell with a heading-derived floating table of contents, a floating transport, a progress bar and a scroll-decoupled follow pill, with no click-to-seek. That shape is the fixed substrate this effort must not disturb. If a visual direction seems to require changing it, record the finding; it is not a licence to change the shape.\\n\\nThe placeholder aesthetic the shape was validated against carried no verdict weight and is not a starting point. Treat it as absent rather than as a first draft.\\n\\nRead first: the spike on the unmerged `idea/read-along-player` branch (tree at `web/`) for what is settled, the read-along player milestone for the surface itself, and `docs/product-design/listening-experience.md` for what the product is meant to feel like.\",\"progress\":0,\"sortOrder\":834.617},{\"id\":\"d33627be-4943-48ff-90f7-a22b2f1fc420\",\"name\":\"ORM relationships\",\"description\":\"Declare the mapped relationships across the models instead of the flat FK-only pattern: items to recipe_versions, items to cost_entries, and whatever else the schema joins. Writes assign through the relationship attributes so SQLAlchemy's unit of work orders inserts and updates by dependency rather than by table order, the manual flush in insert_recipe_version retires, and the queued phase's guarded writes get a second look under autoflush with related objects in play. Born from the production foreign-key incident (commit f02f5b0); to be explored and shaped before building.\",\"progress\":0,\"sortOrder\":848.27},{\"id\":\"a8dac438-de5f-47de-bd28-842f492249b9\",\"name\":\"Recipe reconciliation\",\"description\":\"Stop recipes for one domain from replacing each other. A domain that publishes more than one article format can end up with two recipes bouncing back and forth, because each one matches only one format.\\n\\nWhen a domain's recipe is tested, its previous recipes are tested too. If an older recipe still matches, a reconciliation prompt merges the variants into one recipe that covers both.\\n\\nDepends on the Cloudflare migration: building a recipe that matches both variants needs the recipe logic and the articles extracted with older recipes in one place.\\n\\nTo be shaped and designed before tasks are written.\",\"progress\":0,\"sortOrder\":860.96},{\"id\":\"dec22a7f-5f2d-4690-bc1c-60c6c84a1156\",\"name\":\"Validate demand\",\"description\":\"Find out whether anyone besides the owner wants a private audio read-later queue. The milestone is complete when a stranger has come to nagara, queued a real item, and come back.\\n\\nEverything else in the repository exists to make this answerable. The backend spine (enqueue, extraction, TTS, markdown-formatted paragraphs) is built and proven, and the compute cost is settled at roughly $0.008 per article (`docs/technical-design/tts-service.md`). What is unproven is the product shape and whether there is an audience.\\n\\nThe surface in question is what a stranger meets: the funnel (landing page, login, article creation), the queue, and the player. Extraction internals and TTS cost are settled and not part of this. Read `docs/product-design/what-nagara-is.md` for what is deliberately out of MVP scope and `docs/product-design/queue.md` (\\\"what is not built yet\\\") for the build order agreed on 2026-07-17.\\n\\nDecisions already settled:\\n\\n* The public-funnel work (real auth, onboarding, a landing page) exists in service of this question and nothing else.\\n* Pricing waits until there is an audience to price for; the pricing model is a separate open item that depends on this one.\\n* A builder-driven loop validates shape, never demand, and must not be presented as validated demand. This was learned during the read-along player shape spike.\\n\\nCandidate experiments once strangers can reach nagara, not yet phrased as single tasks:\\n\\n* Whether a paste-a-URL public hook converts a stranger into a first queued item.\\n* Whether a bundle-of-items or a metered-audio-minutes framing reads better.\\n* What a stranger does on their second visit.\\n* Whether an acquisition surface such as a save-to-nagara bookmarklet changes any of that.\\n\\nOut of scope: multi-user scaling before validation (quota, key management, and multi-user behaviour are worth building only if the answer is yes), and pricing before an audience.\",\"progress\":0,\"sortOrder\":976},{\"id\":\"fc4a00b7-fc99-49df-962f-09966bfa3636\",\"name\":\"Formulas read aloud\",\"description\":\"Every formula an article carries reaches a listener as speech and a client as raw LaTeX. No formula is silent and none is read aloud as syntax. Done means the five measured families pass through end to end, each with a fixture and each played once: MathML inline (arXiv/LaTeXML), MathML display (Wikipedia), `$$…$$` inside a bare `<div>` (lilianweng), the raw `$…$` leak (lilianweng) and the raw `\\\\(…\\\\)` leak (colah).\\n\\nDecisions already settled by the design work, with the measurements behind them:\\n\\n* Recovery happens once, at the single `trafilatura.extract` seam inside `_extract_units_from_html` in `api/app/service/extract.py`, via a text carrier, so the plain fetch and the firecrawl fallback both get it. Recovery rewrites the HTML handed to trafilatura; it never re-extracts. `extract_article` keeps returning the original `page.html`, because `images.py` probes that tree and `extract_metadata` reads it for the title.\\n* The outermost math wrapper is replaced, never the `<math>` node: replacing the node recovers 0 of 99 formulas on Wikipedia, because MediaWiki hides the MathML in an a11y wrapper trafilatura discards.\\n* A fourth typed unit, `FormulaUnit`, carries raw LaTeX in `display` and the bare TeX in `latex`.\\n* Inline math is verbalized in place by a hand-rolled rules table. Display math is described on the existing describe budget with the verbalized LaTeX as its floor. A formula never fails the item and is never dropped.\\n* No LaTeX-to-speech library: `latex2speech`, `mathspeak`, `speech-rule-engine` and `mathml2speech` are absent from PyPI, and `pylatexenc` produces unicode Kokoro cannot read.\\n* No formula equivalent of the code path's \\\"every one failed\\\" raise.\\n\\nCode involved: a new `api/app/service/formulas.py`, plus `extract.py`, `describe.py`, the anchor probe in `images.py`, and `api/app/schemas/items.py`. `tts/` is untouched: it receives a list of spoken strings and that contract does not change. `web/` is not built here.\\n\\nThe notes `docs/technical-design/article-extraction.md`, `docs/technical-design/item-contract.md`, `docs/technical-design/the-describer.md` and `docs/product-design/what-gets-read-aloud.md` are written once, at the end, out of all the finished work rather than per task.\\n\\nOut of scope:\\n\\n* Formulas rendered to images with no MathML twin and no usable alt (some Substack and Medium posts). No LaTeX exists to recover; the image path already gives them a described `ImageUnit`.\\n* A page rendering bare `$…$` while declaring no math renderer. Nothing distinguishes it from \\\"between $5 and $10 million\\\"; the residual is accepted.\\n* The KaTeX renderer in `web/`. Raw LaTeX in `display` is a commitment made on behalf of a client nobody has written; honouring it belongs to whoever builds `web/`.\\n* Replacing the verbalizer with a library. None exists; one appearing later is one of the things that would make this shape stop being true.\",\"progress\":25,\"sortOrder\":1948},{\"id\":\"36312d78-c917-4606-b021-8558f2d060ef\",\"name\":\"Extraction issues\",\"description\":\"Defects in what the recipe pipeline extracts from a page and in how the extracted markdown becomes the spoken form, found on real articles after Extraction v2 landed. Each issue names the article it was found on; a fix lands in the recipe prompts or runtime (`pipeline/`) or in the spoken-form derivation (`api/app/service/extract.py`), with a fixture.\",\"progress\":0,\"sortOrder\":2866},{\"id\":\"18988974-aac9-429e-b371-b77e185af3f4\",\"name\":\"Web app\",\"description\":\"The logged-in web surface around the read-along player: the listener's list of items, their settings, the ways out of the player to the original article, a way to report a bad extraction, and serving the web frontend and the API from one origin. The player itself is the Read-along player milestone, its look is Read-along visual design, and the public funnel (landing page, login, first item) is Validate demand.\\n\\nTo be shaped and designed before tasks are written; the issues gathered here are candidates carried over from the backlog, not a settled scope.\",\"progress\":0,\"sortOrder\":3834}]}"}]}]},"uuid":"dc598a05-8b2a-4146-8282-6bdf52a68be5","timestamp":"2026-10-11T05:59:08.239Z","toolUseResult":[{"type":"text","text":"{\"milestones\":[{\"id\":\"cb9c8236-7ea7-404c-b9b6-641d87b398d3\",\"name\":\"Extraction v2\",\"description\":\"Extraction that can be trusted and extended per site. A generic base extraction plus declarative per-domain recipes (substack, medium and similar behave the same once described), an agent loop that writes a recipe for an unknown site, auto-validation gates that fail an item whose extraction is not the article before anyone has to report it, and a per-recipe fetch strategy (direct fetch with a browser user agent, firecrawl, or a real browser) with firecrawl kept as a pluggable backend.\\n\\nBuild order: validation gates, then recipe schema and resolver, then the agent recipe loop, then fetch pluggability, then a reporting UI only if still needed. Paywalled credentials are deferred, possibly forever.\\n\\nThis replaces an earlier plan that put an LLM in the extraction hot path (firecrawl always, HTML always, an LLM instead of trafilatura, with a prompt eval system). The recipes approach keeps per-request extraction deterministic and moves the intelligence to authoring time.\\n\\n**Closed on 2026-10-04.** What shipped: the recipe runtime that runs a stored script deterministically ([ASE-6](https://linear.app/asermax/issue/ASE-6/recipe-runtime-deterministic-execution-behind-run-and-validate)), the Flue authoring and revision agents ([ASE-7](https://linear.app/asermax/issue/ASE-7/agents-authoring-and-revision-loops-on-flue)), the extraction service on Cloudflare ([ASE-61](https://linear.app/asermax/issue/ASE-61/extraction-service-the-pipeline-deployable-on-cloudflare)) and the API's integration with it ([ASE-63](https://linear.app/asermax/issue/ASE-63/api-integration-extraction-client-handle-and-the-recipe-version)); trafilatura is retired. What was dropped: the validation gates ([ASE-5](https://linear.app/asermax/issue/ASE-5/validation-gates-fail-an-item-whose-extraction-is-not-the-article), [ASE-24](https://linear.app/asermax/issue/ASE-24/can-a-ready-item-be-trusted-to-be-the-article-it-claims-to-be)), replaced by the validator plus the agents' not-an-article verdict, and the per-recipe fetch strategy ([ASE-8](https://linear.app/asermax/issue/ASE-8/per-recipe-fetch-strategy-direct-firecrawl-or-browser)), firecrawl staying the one fetch behind the `Fetcher` interface. The defects found afterwards on real articles moved to the Extraction issues milestone; the trafilatura-era bugs that recipes made moot ([ASE-25](https://linear.app/asermax/issue/ASE-25/unfenced-repl-and-code-inside-prose-paragraphs-is-spoken-as-prose), [ASE-26](https://linear.app/asermax/issue/ASE-26/strip-prose-boilerplate-footer-donation-and-sponsor-paragraphs)) were canceled. The reporting UI ([ASE-9](https://linear.app/asermax/issue/ASE-9/bad-extraction-reporting-ui-if-still-needed)) moved out with the web surfaces.\",\"progress\":100,\"sortOrder\":53},{\"id\":\"8f6c74e7-9314-4d0e-b5c8-fd144f08a8b0\",\"name\":\"Markdown and lists\",\"description\":\"Improve what the extraction and TTS pipeline outputs, from both ends: the markdown a recipe extracts, and how that markdown is read aloud.\\n\\n* Markdown fidelity: recipes extract real structure (blockquotes when the text is a quote, headings, lists) instead of flattening everything to plain paragraphs. Verified with a synthetic article that exercises every markdown element, run through each recipe; the structure must come out intact.\\n* Lists in audio: a list is currently read as one paragraph with no breaks. Each item becomes its own unit or chunk, so the TTS delivers it as a list rather than a run-on paragraph.\\n\\nTo be shaped and designed before tasks are written.\",\"progress\":100,\"sortOrder\":515.32},{\"id\":\"1f715c70-f21d-466d-92a3-ef263db6955e\",\"name\":\"Cloudflare migration\",\"description\":\"Move the rest of nagara onto Cloudflare, so the recipe logic and the articles extracted with older recipes live in one place. The extraction pipeline already runs on Cloudflare (`pipeline/`); what else moves is not settled yet.\\n\\nRecipe reconciliation depends on this milestone.\\n\\nTo be shaped and designed before tasks are written.\",\"progress\":0,\"sortOrder\":753.8},{\"id\":\"4232272a-96de-4304-8664-688c8187dafd\",\"name\":\"Read-along player\",\"description\":\"A web surface at `web/` where an item's audio and its text are read together, the text following the audio closely enough that listening while reading is one activity rather than two. One player with two reading modes: a calm scroll-normal reader by default, and an opt-in focus mode that centres and enlarges the active paragraph. It consumes the existing item contract unchanged: no per-unit `type` field, no word-level timing, nothing in `api/` or `tts/`. Done means the surface is built, deployed and dogfooded on real generated items, with its mechanism recorded as a note in `docs/technical-design/`.\\n\\nDecisions settled by the spike, which is preserved on the unmerged `idea/read-along-player` branch with its tree relocated to `web/`:\\n\\n* The stack is TanStack Start with Panda-CSS. The build is a rewrite of the spike, not a merge.\\n* A dark immersive shell with a heading-derived floating table of contents, a floating transport and a progress bar.\\n* Scroll-decoupled navigation: a seek-to-here follow pill, ±10 s skip, and resume. No click-to-seek.\\n* Highlight sync runs off `requestAnimationFrame` polling `currentTime`, never `timeupdate`. Measured lag was 19 to 26 ms against a 200 ms budget, re-locking immediately after a seek.\\n* Two things from the spike must not be copied: its global `ka-*` CSS class names, which leaked between components once, and its localStorage resume, which is a stand-in rather than a decision.\\n\\nRead first: `docs/product-design/listening-experience.md`, `docs/technical-design/read-along-timing.md` (timing mechanism and the seek nudge), `docs/technical-design/item-contract.md`, and `docs/technical-design/invariants.md` for the sync budget.\\n\\nOpen questions, each blocking a slice rather than the whole build: how lists, code and tables behave in focus mode, since centring and enlarging breaks their left-aligned structure; whether blockquote and table render and highlight correctly, since the spike's probe for them was never built; whether the mobile breakpoint holds on a real device; whether resume needs a server-side position to follow a listener across devices; how an image unit renders without being treated as prose.\\n\\nThe shape evidence is builder-confounded: the same person built and judged the spike on two real articles. It validates shape, UX and the functional contract, not demand or a fresh user's experience; those belong to the demand-validation work.\\n\\nOut of scope: visual design (typography, colour, motion and brand feel are a separate milestone that treats this layout as fixed; the spike's placeholder aesthetic carries no verdict weight); click-to-seek (whether its absence is felt as friction by anyone other than the builder is a demand question); word-level highlighting (the contract is paragraph-level and nothing needed finer); caption export, which maps the same timing windows onto cue timings and is its own issue.\",\"progress\":25,\"sortOrder\":806.12},{\"id\":\"5d1d2f53-65e7-4600-bb34-bcd3bbd183b7\",\"name\":\"Read-along visual design\",\"description\":\"A proper visual design for the read-along player and, by extension, the web surface: a design language, typography, colour, motion, and light and dark modes, coherent enough that a stranger reads it as a finished product. Judged on aesthetic coherence and quality against real long-form articles rather than sample text, because sustained prose is where typography either works or does not.\\n\\nAlready settled and not up for redesign: the player's layout, navigation and structure. The shape work fixed one player with a calm scroll-normal default and an opt-in focus mode, inside a dark immersive shell with a heading-derived floating table of contents, a floating transport, a progress bar and a scroll-decoupled follow pill, with no click-to-seek. That shape is the fixed substrate this effort must not disturb. If a visual direction seems to require changing it, record the finding; it is not a licence to change the shape.\\n\\nThe placeholder aesthetic the shape was validated against carried no verdict weight and is not a starting point. Treat it as absent rather than as a first draft.\\n\\nRead first: the spike on the unmerged `idea/read-along-player` branch (tree at `web/`) for what is settled, the read-along player milestone for the surface itself, and `docs/product-design/listening-experience.md` for what the product is meant to feel like.\",\"progress\":0,\"sortOrder\":834.617},{\"id\":\"d33627be-4943-48ff-90f7-a22b2f1fc420\",\"name\":\"ORM relationships\",\"description\":\"Declare the mapped relationships across the models instead of the flat FK-only pattern: items to recipe_versions, items to cost_entries, and whatever else the schema joins. Writes assign through the relationship attributes so SQLAlchemy's unit of work orders inserts and updates by dependency rather than by table order, the manual flush in insert_recipe_version retires, and the queued phase's guarded writes get a second look under autoflush with related objects in play. Born from the production foreign-key incident (commit f02f5b0); to be explored and shaped before building.\",\"progress\":0,\"sortOrder\":848.27},{\"id\":\"a8dac438-de5f-47de-bd28-842f492249b9\",\"name\":\"Recipe reconciliation\",\"description\":\"Stop recipes for one domain from replacing each other. A domain that publishes more than one article format can end up with two recipes bouncing back and forth, because each one matches only one format.\\n\\nWhen a domain's recipe is tested, its previous recipes are tested too. If an older recipe still matches, a reconciliation prompt merges the variants into one recipe that covers both.\\n\\nDepends on the Cloudflare migration: building a recipe that matches both variants needs the recipe logic and the articles extracted with older recipes in one place.\\n\\nTo be shaped and designed before tasks are written.\",\"progress\":0,\"sortOrder\":860.96},{\"id\":\"dec22a7f-5f2d-4690-bc1c-60c6c84a1156\",\"name\":\"Validate demand\",\"description\":\"Find out whether anyone besides the owner wants a private audio read-later queue. The milestone is complete when a stranger has come to nagara, queued a real item, and come back.\\n\\nEverything else in the repository exists to make this answerable. The backend spine (enqueue, extraction, TTS, markdown-formatted paragraphs) is built and proven, and the compute cost is settled at roughly $0.008 per article (`docs/technical-design/tts-service.md`). What is unproven is the product shape and whether there is an audience.\\n\\nThe surface in question is what a stranger meets: the funnel (landing page, login, article creation), the queue, and the player. Extraction internals and TTS cost are settled and not part of this. Read `docs/product-design/what-nagara-is.md` for what is deliberately out of MVP scope and `docs/product-design/queue.md` (\\\"what is not built yet\\\") for the build order agreed on 2026-07-17.\\n\\nDecisions already settled:\\n\\n* The public-funnel work (real auth, onboarding, a landing page) exists in service of this question and nothing else.\\n* Pricing waits until there is an audience to price for; the pricing model is a separate open item that depends on this one.\\n* A builder-driven loop validates shape, never demand, and must not be presented as validated demand. This was learned during the read-along player shape spike.\\n\\nCandidate experiments once strangers can reach nagara, not yet phrased as single tasks:\\n\\n* Whether a paste-a-URL public hook converts a stranger into a first queued item.\\n* Whether a bundle-of-items or a metered-audio-minutes framing reads better.\\n* What a stranger does on their second visit.\\n* Whether an acquisition surface such as a save-to-nagara bookmarklet changes any of that.\\n\\nOut of scope: multi-user scaling before validation (quota, key management, and multi-user behaviour are worth building only if the answer is yes), and pricing before an audience.\",\"progress\":0,\"sortOrder\":976},{\"id\":\"fc4a00b7-fc99-49df-962f-09966bfa3636\",\"name\":\"Formulas read aloud\",\"description\":\"Every formula an article carries reaches a listener as speech and a client as raw LaTeX. No formula is silent and none is read aloud as syntax. Done means the five measured families pass through end to end, each with a fixture and each played once: MathML inline (arXiv/LaTeXML), MathML display (Wikipedia), `$$…$$` inside a bare `<div>` (lilianweng), the raw `$…$` leak (lilianweng) and the raw `\\\\(…\\\\)` leak (colah).\\n\\nDecisions already settled by the design work, with the measurements behind them:\\n\\n* Recovery happens once, at the single `trafilatura.extract` seam inside `_extract_units_from_html` in `api/app/service/extract.py`, via a text carrier, so the plain fetch and the firecrawl fallback both get it. Recovery rewrites the HTML handed to trafilatura; it never re-extracts. `extract_article` keeps returning the original `page.html`, because `images.py` probes that tree and `extract_metadata` reads it for the title.\\n* The outermost math wrapper is replaced, never the `<math>` node: replacing the node recovers 0 of 99 formulas on Wikipedia, because MediaWiki hides the MathML in an a11y wrapper trafilatura discards.\\n* A fourth typed unit, `FormulaUnit`, carries raw LaTeX in `display` and the bare TeX in `latex`.\\n* Inline math is verbalized in place by a hand-rolled rules table. Display math is described on the existing describe budget with the verbalized LaTeX as its floor. A formula never fails the item and is never dropped.\\n* No LaTeX-to-speech library: `latex2speech`, `mathspeak`, `speech-rule-engine` and `mathml2speech` are absent from PyPI, and `pylatexenc` produces unicode Kokoro cannot read.\\n* No formula equivalent of the code path's \\\"every one failed\\\" raise.\\n\\nCode involved: a new `api/app/service/formulas.py`, plus `extract.py`, `describe.py`, the anchor probe in `images.py`, and `api/app/schemas/items.py`. `tts/` is untouched: it receives a list of spoken strings and that contract does not change. `web/` is not built here.\\n\\nThe notes `docs/technical-design/article-extraction.md`, `docs/technical-design/item-contract.md`, `docs/technical-design/the-describer.md` and `docs/product-design/what-gets-read-aloud.md` are written once, at the end, out of all the finished work rather than per task.\\n\\nOut of scope:\\n\\n* Formulas rendered to images with no MathML twin and no usable alt (some Substack and Medium posts). No LaTeX exists to recover; the image path already gives them a described `ImageUnit`.\\n* A page rendering bare `$…$` while declaring no math renderer. Nothing distinguishes it from \\\"between $5 and $10 million\\\"; the residual is accepted.\\n* The KaTeX renderer in `web/`. Raw LaTeX in `display` is a commitment made on behalf of a client nobody has written; honouring it belongs to whoever builds `web/`.\\n* Replacing the verbalizer with a library. None exists; one appearing later is one of the things that would make this shape stop being true.\",\"progress\":25,\"sortOrder\":1948},{\"id\":\"36312d78-c917-4606-b021-8558f2d060ef\",\"name\":\"Extraction issues\",\"description\":\"Defects in what the recipe pipeline extracts from a page and in how the extracted markdown becomes the spoken form, found on real articles after Extraction v2 landed. Each issue names the article it was found on; a fix lands in the recipe prompts or runtime (`pipeline/`) or in the spoken-form derivation (`api/app/service/extract.py`), with a fixture.\",\"progress\":0,\"sortOrder\":2866},{\"id\":\"18988974-aac9-429e-b371-b77e185af3f4\",\"name\":\"Web app\",\"description\":\"The logged-in web surface around the read-along player: the listener's list of items, their settings, the ways out of the player to the original article, a way to report a bad extraction, and serving the web frontend and the API from one origin. The player itself is the Read-along player milestone, its look is Read-along visual design, and the public funnel (landing page, login, first item) is Validate demand.\\n\\nTo be shaped and designed before tasks are written; the issues gathered here are candidates carried over from the backlog, not a settled scope.\",\"progress\":0,\"sortOrder\":3834}]}"}],"serverClassifierContext":{"request":"5827a1d8-cca5-46b7-9b7b-a9c7a4e0fbb8","context":{"git_state":{"cwd":"/home/agus/workspace/asermax/nagara","root":"/home/agus/workspace/asermax/nagara","branch":"feat/cloudflare-migration","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"asermax/nagara","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"asermax/nagara","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"asermax/nagara","visibility":"public"},{"host":"github.com","remote":"filadd/cc-plugin-marketplace","visibility":"private"}]}},"live_cwd":"/home/agus/workspace/asermax/nagara","platform":"linux"}},"mcpMeta":{"_meta":{"io.modelcontextprotocol/serverInfo":{"name":"Linear MCP","title":"Linear","icons":[{"src":"https://static.linear.app/integrations/mcp/icon.svg","mimeType":"image/svg+xml"}],"version":"1.0.0","websiteUrl":"https://linear.app"}}},"sourceToolAssistantUUID":"9c81ff1d-c3d6-43b8-9ed5-d878669916ce","permissionDecision":{"decision":"accept","source":"config","reasonType":"classifier"},"session_id":"f14bad90-e61e-4c27-a38f-bf7cbc76465e","userType":"external","entrypoint":"cli","cwd":"/home/agus/workspace/asermax/nagara","sessionId":"f14bad90-e61e-4c27-a38f-bf7cbc76465e","version":"2.1.296","gitBranch":"feat/cloudflare-migration","slug":"atomic-stirring-rossum"}
