down\": \"7.2.4\",\n    \"valibot\": \"1.5.0\"\n  },\n  \"devDependencies\": {\n    \"@biomejs/biome\": \"2.5.14\",\n    \"@cloudflare/vite-plugin\": \"1.56.0\",\n    \"@cloudflare/vitest-plugin\": \"1.1.13\",\n    \"@cloudflare/workers-types\": \"5.20260919.1\",\n    \"@flue/vite\": \"2.1.0\",\n    \"@types/turndown\": \"5.0.6\",\n    \"domhandler\": \"6.0.1\",\n    \"esbuild\": \"0.28.2\",\n    \"typescript\": \"7.0.2\",\n    \"vite\": \"8.3.0\",\n    \"vitest\": \"4.1.0\",\n    \"wrangler\": \"4.135.0\"\n  },\n  \"packageManager\": \"pnpm@11.26.0\"\n}\n{\n  \"$schema\": \"node_modules/wrangler/config-schema.json\",\n  \"name\": \"nagara\",\n  \"compatibility_date\": \"2026-09-01\",\n  \"compatibility_flags\": [\"nodejs_compat\"],\n  \"worker_loaders\": [{ \"binding\": \"LOADER\" }],\n  \"workflows\": [\n    { \"name\": \"extraction\", \"binding\": \"EXTRACTION\", \"class_name\": \"ExtractionWorkflow\" }\n  ],\n  \"durable_objects\": {\n    \"bindings\": [\n      { \"name\": \"DOMAIN_QUEUE\", \"class_name\": \"DomainQueue\" },\n      { \"name\": \"JOB_INDEX\", \"class_name\": \"JobIndex\" }\n    ]\n  },\n  \"migrations\": [\n    { \"tag\": \"v1\", \"new_sqlite_classes\": [\"DomainQueue\", \"JobIndex\"] },\n    { \"tag\": \"flue-class-FlueAuthorAgent\", \"new_sqlite_classes\": [\"FlueAuthorAgent\"] },\n    { \"tag\": \"flue-class-FlueRevisorAgent\", \"new_sqlite_classes\": [\"FlueRevisorAgent\"] }\n  ],\n  \"vars\": {\n    \"agentModel\": \"cloudflare-ai-gateway/workers-ai/@cf/zai-org/glm-5.3-flash\",\n    \"CLOUDFLARE_ACCOUNT_ID\": \"2b32439a1d8fdcdf00a9f7f654a11a6d\",\n    \"CLOUDFLARE_GATEWAY_ID\": \"nagara\",\n    \"agentMaxTurns\": 100,\n    \"authoringRetries\": 1,\n    \"revisionRetries\": 2,\n    \"leaseAlarmMs\": 60000,\n    \"indexSweepMs\": 86400000,\n    \"recipeCpuMs\": 2000,\n    \"maxHtmlBytes\": 1048576\n  }\n}\nimport { cloudflare } from \"@cloudflare/vite-plugin\";\nimport { flue, flueWorkerConfig } from \"@flue/vite\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [flue(), cloudflare({ config: flueWorkerConfig() })],\n});\nimport { cloudflareTest } from \"@cloudflare/vitest-plugin\";\nimport { defineConfig } from \"vitest/config\";\n\nexport default defineConfig({\n  plugins: [\n    cloudflareTest({\n      main: \"./src/index.ts\",\n      wrangler: { configPath: \"./wrangler.jsonc\" },\n      miniflare: {\n        compatibilityDate: \"2026-09-01\",\n        compatibilityFlags: [\"nodejs_compat\"],\n      },\n    }),\n  ],\n  test: {\n    include: [\"test/**/*.test.ts\"],\n  },\n});\n../api:\nalembic.ini\napp\ndata\nmigrations\nprototype_cache\npyproject.toml\nrailway.toml\ntests\nuv.lock\n\n../api/app:\nconfig.py\nendpoints\nhelpers.py\n__init__.py\nmain.py\nmodels\n__pycache__\nschemas\nsecurity.py\nservice\n\n../tts:\napp.py\npyproject.toml\ntests\nuv.lock","is_error":false}]},"uuid":"2f4030d0-4974-40d6-aa0a-2522b2c7adf0","timestamp":"2026-10-11T04:47:55.703Z","toolUseResult":{"stdout":"scripts/build-injection-bundle.mjs\nsrc/agents/author.ts\nsrc/agents/extract-tool.ts\nsrc/agents/gateway.ts\nsrc/agents/model-provider.ts\nsrc/agents/prompts.ts\nsrc/agents/revisor.ts\nsrc/agents/settlement.ts\nsrc/app.ts\nsrc/cloudflare.ts\nsrc/errors.ts\nsrc/http/job-status.ts\nsrc/http/read.ts\nsrc/http/routes.ts\nsrc/index.ts\nsrc/queue/domain-queue.ts\nsrc/queue/job-index.ts\nsrc/runtime/glue.ts\nsrc/runtime/injection/entry.ts\nsrc/runtime/injection/markdown.ts\nsrc/runtime/paths.ts\nsrc/runtime/recipe.ts\nsrc/runtime/run.ts\nsrc/runtime/units.ts\nsrc/runtime/validate.ts\nsrc/types/domino.d.ts\nsrc/workflow/extraction.ts\nsrc/workflow/world.ts\ntest/domain-queue.test.ts\ntest/dynamic-workers-proof.test.ts\ntest/extraction-workflow.test.ts\ntest/fixtures/article.ts\ntest/helpers/http.ts\ntest/helpers/world.ts\ntest/http.test.ts\ntest/job-index.test.ts\ntest/markdown-units.test.ts\ntest/prompts.test.ts\ntest/read-path.test.ts\ntest/runtime-smoke.test.ts\ntest/runtime.test.ts\ntest/settlement.test.ts\n{\n  \"name\": \"nagara-pipeline\",\n  \"private\": true,\n  \"type\": \"module\",\n  \"scripts\": {\n    \"build:bundle\": \"node scripts/build-injection-bundle.mjs\",\n    \"dev\": \"pnpm build:bundle && vite dev\",\n    \"build\": \"pnpm build:bundle && vite build\",\n    \"deploy\": \"pnpm build && wrangler deploy -c dist/nagara/wrangler.json\",\n    \"test\": \"pnpm build:bundle && vitest run\",\n    \"lint\": \"biome check .\",\n    \"types\": \"pnpm build:bundle && tsc --noEmit\"\n  },\n  \"dependencies\": {\n    \"@earendil-works/pi-ai\": \"0.87.0\",\n    \"@flue/runtime\": \"2.1.0\",\n    \"@mixmark-io/domino\": \"2.2.0\",\n    \"@truto/turndown-plugin-gfm\": \"1.0.5\",\n    \"cheerio\": \"1.2.0\",\n    \"turndown\": \"7.2.4\",\n    \"valibot\": \"1.5.0\"\n  },\n  \"devDependencies\": {\n    \"@biomejs/biome\": \"2.5.14\",\n    \"@cloudflare/vite-plugin\": \"1.56.0\",\n    \"@cloudflare/vitest-plugin\": \"1.1.13\",\n    \"@cloudflare/workers-types\": \"5.20260919.1\",\n    \"@flue/vite\": \"2.1.0\",\n    \"@types/turndown\": \"5.0.6\",\n    \"domhandler\": \"6.0.1\",\n    \"esbuild\": \"0.28.2\",\n    \"typescript\": \"7.0.2\",\n    \"vite\": \"8.3.0\",\n    \"vitest\": \"4.1.0\",\n    \"wrangler\": \"4.135.0\"\n  },\n  \"packageManager\": \"pnpm@11.26.0\"\n}\n{\n  \"$schema\": \"node_modules/wrangler/config-schema.json\",\n  \"name\": \"nagara\",\n  \"compatibility_date\": \"2026-09-01\",\n  \"compatibility_flags\": [\"nodejs_compat\"],\n  \"worker_loaders\": [{ \"binding\": \"LOADER\" }],\n  \"workflows\": [\n    { \"name\": \"extraction\", \"binding\": \"EXTRACTION\", \"class_name\": \"ExtractionWorkflow\" }\n  ],\n  \"durable_objects\": {\n    \"bindings\": [\n      { \"name\": \"DOMAIN_QUEUE\", \"class_name\": \"DomainQueue\" },\n      { \"name\": \"JOB_INDEX\", \"class_name\": \"JobIndex\" }\n    ]\n  },\n  \"migrations\": [\n    { \"tag\": \"v1\", \"new_sqlite_classes\": [\"DomainQueue\", \"JobIndex\"] },\n    { \"tag\": \"flue-class-FlueAuthorAgent\", \"new_sqlite_classes\": [\"FlueAuthorAgent\"] },\n    { \"tag\": \"flue-class-FlueRevisorAgent\", \"new_sqlite_classes\": [\"FlueRevisorAgent\"] }\n  ],\n  \"vars\": {\n    \"agentModel\": \"cloudflare-ai-gateway/workers-ai/@cf/zai-org/glm-5.3-flash\",\n    \"CLOUDFLARE_ACCOUNT_ID\": \"2b32439a1d8fdcdf00a9f7f654a11a6d\",\n    \"CLOUDFLARE_GATEWAY_ID\": \"nagara\",\n    \"agentMaxTurns\": 100,\n    \"authoringRetries\": 1,\n    \"revisionRetries\": 2,\n    \"leaseAlarmMs\": 60000,\n    \"indexSweepMs\": 86400000,\n    \"recipeCpuMs\": 2000,\n    \"maxHtmlBytes\": 1048576\n  }\n}\nimport { cloudflare } from \"@cloudflare/vite-plugin\";\nimport { flue, flueWorkerConfig } from \"@flue/vite\";\nimport { defineConfig } from \"vite\";\n\nexport default defineConfig({\n  plugins: [flue(), cloudflare({ config: flueWorkerConfig() })],\n});\nimport { cloudflareTest } from \"@cloudflare/vitest-plugin\";\nimport { defineConfig } from \"vitest/config\";\n\nexport default defineConfig({\n  plugins: [\n    cloudflareTest({\n      main: \"./src/index.ts\",\n      wrangler: { configPath: \"./wrangler.jsonc\" },\n      miniflare: {\n        compatibilityDate: \"2026-09-01\",\n        compatibilityFlags: [\"nodejs_compat\"],\n      },\n    }),\n  ],\n  test: {\n    include: [\"test/**/*.test.ts\"],\n  },\n});\n../api:\nalembic.ini\napp\ndata\nmigrations\nprototype_cache\npyproject.toml\nrailway.toml\ntests\nuv.lock\n\n../api/app:\nconfig.py\nendpoints\nhelpers.py\n__init__.py\nmain.py\nmodels\n__pycache__\nschemas\nsecurity.py\nservice\n\n../tts:\napp.py\npyproject.toml\ntests\nuv.lock","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"1e97d79d-f137-4696-8cef-bbbb5dbb09b2","context":{"git_state":{"cwd":"/home/agus/workspace/asermax/nagara","root":"/home/agus/workspace/asermax/nagara","branch":"feat/cloudflare-migration","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"u