-design"},".scratch/cloudflare-migration/briefs/implement-common.md":{"backupFileName":"0b3d7f3d15422b0f@v2","version":2,"backupTime":"2026-10-11T06:42:46.571Z","realParentDir":"/home/agus/workspace/asermax/nagara/.scratch/cloudflare-migration/briefs"},".scratch/cloudflare-migration/learn/round4/drafts.md":{"backupFileName":"747edf2f7b0110d6@v2","version":2,"backupTime":"2026-10-11T22:52:22.939Z","realParentDir":"/home/agus/workspace/asermax/nagara/.scratch/cloudflare-migration/learn/round4"},"CLAUDE.md":{"backupFileName":"192deea04b84b9d9@v4","version":4,"backupTime":"2026-10-11T23:22:50.251Z","realParentDir":"/home/agus/workspace/asermax/nagara"}},"timestamp":"2026-10-11T23:22:50.251Z"},"isSnapshotUpdate":false}
