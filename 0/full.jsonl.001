KEY,\n  url TEXT NOT NULL,\n  title TEXT,\n  voice TEXT NOT NULL,\n  status TEXT NOT NULL CHECK (status IN ('queued', 'generating', 'ready', 'failed')),\n  created_at TEXT NOT NULL,\n  updated_at TEXT NOT NULL,\n  queued_at TEXT NOT NULL,\n  workflow_instance_id TEXT,\n  current_step TEXT,\n  extraction_domain TEXT,\n  recipe_version_id TEXT REFERENCES recipe_versions (id),\n  retry_count INTEGER NOT NULL DEFAULT 0,\n  duration REAL,\n  audio_format TEXT,\n  units TEXT CHECK (units IS NULL OR json_valid(units)),\n  degradations TEXT CHECK (degradations IS NULL OR json_valid(degradations)),\n  error TEXT\n);\n\nCREATE TABLE cost_entries (\n  id TEXT PRIMARY KEY,\n  item_id TEXT NOT NULL REFERENCES items (id),\n  type TEXT NOT NULL CHECK (type IN ('firecrawl', 'describer', 'tts')),\n  quantity REAL NOT NULL,\n  unit TEXT NOT NULL CHECK (unit IN ('credits', 'calls', 'seconds')),\n  dollars REAL NOT NULL,\n  cached INTEGER NOT NULL DEFAULT 0 CHECK (cached IN (0, 1)),\n  detail TEXT CHECK (detail IS NULL OR json_valid(detail)),\n  created_at TEXT NOT NULL\n);\n\nCREATE INDEX ix_cost_entries_item_id ON cost_entries (item_id);","stderr":"","interrupted":false,"isImage":false,"noOutputExpected":false},"serverClassifierContext":{"request":"6b740bea-0b39-417b-8148-434aec7a4b3a","context":{"git_state":{"cwd":"/home/agus/workspace/asermax/nagara","root":"/home/agus/workspace/asermax/nagara","branch":"feat/cloudflare-migration","default_branch":"main","status":{"clean":true,"counts":{"staged":0,"modified":0,"untracked":null,"untracked_normal":0},"porcelain":null,"truncated":false},"visibility":{"origin":{"host":"github.com","remote":"asermax/nagara","visibility":"public"},"push_remote":"origin","remotes":[{"name":"origin","host":"github.com","remote":"asermax/nagara","visibility":"public"}],"visibility_cache":[{"host":"github.com","remote":"asermax/nagara","visibility":"public"},{"host":"github.com","remote":"filadd/cc-plugin-marketplace","visibility":"private"}]}},"live_cwd":"/