cap', 'recipe or release', 'one'], 'restart from lease', 'test'],\n          ['D17', 'retries an item whose instance was never created', ['failed under the cap', 'none: never created', 'one'], 'create called', 'test'],\n          ['D18', 'retries an item at 3 retries', ['failed at the cap', 'another step', 'one'], '409', 'test'],\n          ['D19', 'retries a ready item', ['not failed', 'another step', 'one'], '409', 'test'],\n          ['D20', 'retries one item twice at once', ['failed under the cap', 'another step', 'two'], 'one 202, one 409, retry_count + 1', 'test'],\n          ['D21', 'retries an unknown id', ['missing', 'another step', 'one'], '404', 'test'],\n          ['D22', 'retries a failed item on the deployed API', ['failed under the cap', 'another step', 'one'], 'the item reaches ready', 'manual'],\n        ],\n      },\n      {\n        title: 'D4 GET audio · GET images/{hash}', root: 'GET /items/{id}/audio · /images/{hash}',\n        classes: [['route', ['audio', 'image']], ['item', ['ready', 'not ready', 'missing']], ['hash', ['stored', 'unknown']]],\n        rows: [\n          ['D23', 'asks for a ready item\\'s audio', ['audio', 'ready', 'stored'], '307 to a URL signed for audio/<id>, X-Amz-Expires=3600', 'test'],\n          ['D24', 'asks for a generating item\\'s audio', ['audio', 'not ready', 'stored'], '404', 'test'],\n          ['D25', 'asks for a stored image', ['image', 'not ready', 'stored'], '307 to a URL signed for images/<hash>', 'test'],\n          ['D26', 'asks for an image of an unknown item', ['image', 'missing', 'stored'], '404', 'test'],\n          ['D27', 'asks for an unknown hash', ['image', 'ready', 'unknown'], '307 anyway', 'test'],\n          ['D28', 'follows the audio 307 in a browser audio element', ['audio', 'ready', 'stored'], 'it plays and seeks', 'manual'],\n        ],\n      },\n      {\n        title: 'D5 the key guard and /health', root: 'every route',\n        classes: [['key', ['missing', 'wrong', 'right']], ['route'