date","mcp__linear-server__extract_images","mcp__linear-server__get_agent_skill","mcp__linear-server__get_attachment","mcp__linear-server__get_diff","mcp__linear-server__get_diff_threads","mcp__linear-server__get_document","mcp__linear-server__get_issue","mcp__linear-server__get_issue_status","mcp__linear-server__get_milestone","mcp__linear-server__get_notifications","mcp__linear-server__get_project","mcp__linear-server__get_release","mcp__linear-server__get_release_note","mcp__linear-server__get_status_updates","mcp__linear-server__get_team","mcp__linear-server__get_template","mcp__linear-server__get_triage_responsibility","mcp__linear-server__get_user","mcp__linear-server__get_workspace","mcp__linear-server__list_agent_skills","mcp__linear-server__list_comments","mcp__linear-server__list_custom_views","mcp__linear-server__list_cycles","mcp__linear-server__list_diffs","mcp__linear-server__list_documents","mcp__linear-server__list_issue_labels","mcp__linear-server__list_issue_statuses","mcp__linear-server__list_issues","mcp__linear-server__list_milestones","mcp__linear-server__list_project_labels","mcp__linear-server__list_projects","mcp__linear-server__list_release_notes","mcp__linear-server__list_release_pipelines","mcp__linear-server__list_releases","mcp__linear-server__list_teams","mcp__linear-server__list_templates","mcp__linear-server__list_users","mcp__linear-server__mark_notification","mcp__linear-server__merge_diff","mcp__linear-server__prepare_attachment_upload","mcp__linear-server__resolve_diff_thread","mcp__linear-server__restore_issue_label","mcp__linear-server__restore_project_label","mcp__linear-server__retire_issue_label","mcp__linear-server__retire_project_label","mcp__linear-server__save_comment","mcp__linear-server__save_diff_comment","mcp__linear-server__save_document","mcp__linear-server__save_issue","mcp__linear-server__save_issue_label","mcp__linear-server__save_milestone","mcp__linear-server__save_project","mcp__linear-server__save_project_label","mcp__linear-server__save_release","mcp__linear-server__save_release_note","mcp__linear-server__save_status_update","mcp__linear-server__search_documentation","mcp__linear-server__share_issue","mcp__linear-server__submit_diff_review","mcp__linear-server__unshare_issue","mcp__linear-server__update_diff","mcp__pencil__execute","mcp__pencil__get_app_state","mcp__pencil__get_style","mcp__pencil__read_skill","mcp__plannotator__plannotator","mcp__plannotator__plannotator_inbox"],"removedNames":[],"wireHiddenNames":[],"readdedNames":[]},"type":"attachment","uuid":"d2a1edf0-11f3-423c-86d5-23ce894f4d45","timestamp":"2026-10-11T04:42:16.131Z","rendered":[{"content":"<system-reminder>\nThe following deferred tools are now available via ToolSearch. Their schemas are NOT loaded — calling them directly will fail with InputValidationError. Use ToolSearch with query \"select:<name>[,<name>...]\" to load tool schemas before calling them:\nEndConversation\nEnterPlanMode\nEnterWorktree\nExitPlanMode\nExitWorktree\nListMcpResourcesTool\nMonitor\nNotebookEdit\nPushNotification\nReadMcpResourceDirTool\nReadMcpResourceTool\nRemoteTrigger\nSendMessage\nTaskStop\nWebFetch\nWebSearch\nmcp__cloudflare__authenticate\nmcp__cloudflare__complete_authentication\nmcp__context7__query-docs\nmcp__context7__resolve-library-id\nmcp__linear-server__create_attachment\nmcp__linear-server__create_attachment_from_upload\nmcp__linear-server__create_issue_label\nmcp__linear-server__delete_attachment\nmcp__linear-server__delete_comment\nmcp__linear-server__delete_diff_comment\nmcp__linear-server__delete_status_update\nmcp__linear-server__extract_images\nmcp__linear-server__get_agent_skill\nmcp__linear-server__get_attachment\nmcp__linear-server__get_diff\nmcp__linear-server__get_diff_threads\nmcp__linear-server__get_document\nmcp__linear-server__get_issue\nmcp__linear-server__get_issue_status\nmcp__linear-server__get_milestone\nmcp__linear-server__get_notifications\nmcp__linear-server__get_project\nmcp__li