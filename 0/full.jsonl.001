:{\"value\":2,\"name\":\"High\"}},{\"id\":\"ASE-67\",\"title\":\"Shared recipe contract carries the markdown rules\",\"status\":\"Done\",\"projectMilestone\":{\"id\":\"8f6c74e7-9314-4d0e-b5c8-fd144f08a8b0\",\"name\":\"Markdown and lists\"},\"labels\":[\"Improvement\"],\"priority\":{\"value\":3,\"name\":\"Medium\"}},{\"id\":\"ASE-66\",\"title\":\"Validator reports a declared unit that is an <li> on its own\",\"status\":\"Done\",\"projectMilestone\":{\"id\":\"8f6c74e7-9314-4d0e-b5c8-fd144f08a8b0\",\"name\":\"Markdown and lists\"},\"labels\":[\"Improvement\"],\"priority\":{\"value\":2,\"name\":\"High\"}},{\"id\":\"ASE-68\",\"title\":\"Spoken form keeps one line per block, numbers, and table rows\",\"status\":\"Done\",\"projectMilestone\":{\"id\":\"8f6c74e7-9314-4d0e-b5c8-fd144f08a8b0\",\"name\":\"Markdown and lists\"},\"labels\":[\"Improvement\"],\"priority\":{\"value\":2,\"name\":\"High\"}},{\"id\":\"ASE-64\",\"title\":\"Converter keeps the element's own tag, wraps a bare <pre>, and converts GFM\",\"status\":\"Done\",\"projectMilestone\":{\"id\":\"8f6c74e7-9314-4d0e-b5c8-fd144f08a8b0\",\"name\":\"Markdown and lists\"},\"labels\":[\"Improvement\"],\"priority\":{\"value\":2,\"name\":\"High\"}},{\"id\":\"ASE-69\",\"title\":\"Sanitize tail keeps newlines, strips only markers touching text, and speaks operators\",\"status\":\"Done\",\"projectMilestone\":{\"id\":\"8f6c74e7-9314-4d0e-b5c8-fd144f08a8b0\",\"name\":\"Markdown and lists\"},\"labels\":[\"Improvement\"],\"priority\":{\"value\":2,\"name\":\"High\"}},{\"id\":\"ASE-62\",\"title\":\"Dynamic Workers proof: recipe source executes on the platform\",\"status\":\"Done\",\"projectMilestone\":{\"id\":\"cb9c8236-7ea7-404c-b9b6-641d87b398d3\",\"name\":\"Extraction v2\"},\"labels\":[\"Spike\"],\"priority\":{\"value\":2,\"name\":\"High\"}},{\"id\":\"ASE-7\",\"title\":\"Agents: authoring and revision loops on Flue\",\"status\":\"Done\",\"projectMilestone\":{\"id\":\"cb9c8236-7ea7-404c-b9b6-641d87b398d3\",\"name\":\"Extraction v2\