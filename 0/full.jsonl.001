near-server__get_release\nmcp__linear-server__get_release_note\nmcp__linear-server__get_status_updates\nmcp__linear-server__get_team\nmcp__linear-server__get_template\nmcp__linear-server__get_triage_responsibility\nmcp__linear-server__get_user\nmcp__linear-server__get_workspace\nmcp__linear-server__list_agent_skills\nmcp__linear-server__list_comments\nmcp__linear-server__list_custom_views\nmcp__linear-server__list_cycles\nmcp__linear-server__list_diffs\nmcp__linear-server__list_documents\nmcp__linear-server__list_issue_labels\nmcp__linear-server__list_issue_statuses\nmcp__linear-server__list_issues\nmcp__linear-server__list_milestones\nmcp__linear-server__list_project_labels\nmcp__linear-server__list_projects\nmcp__linear-server__list_release_notes\nmcp__linear-server__list_release_pipelines\nmcp__linear-server__list_releases\nmcp__linear-server__list_teams\nmcp__linear-server__list_templates\nmcp__linear-server__list_users\nmcp__linear-server__mark_notification\nmcp__linear-server__merge_diff\nmcp__linear-server__prepare_attachment_upload\nmcp__linear-server__resolve_diff_thread\nmcp__linear-server__restore_issue_label\nmcp__linear-server__restore_project_label\nmcp__linear-server__retire_issue_label\nmcp__linear-server__retire_project_label\nmcp__linear-server__save_comment\nmcp__linear-server__save_diff_comment\nmcp__linear-server__save_document\nmcp__linear-server__save_issue\nmcp__linear-server__save_issue_label\nmcp__linear-server__save_milestone\nmcp__linear-server__save_project\nmcp__linear-server__save_project_label\nmcp__linear-server__save_release\nmcp__linear-server__save_release_note\nmcp__linear-server__save_status_update\nmcp__linear-server__search_documentation\nmcp__linear-server__share_issue\nmcp__linear-server__submit_diff_review\nmcp__linear-server__unshare_issue\nmcp__linear-server__update_diff\nmcp__pencil__execute\nmcp__pencil__get_app_state\nmcp__pencil__get_style\nmcp__pencil__read_skill\nmcp__plannotator__plannotator\nmcp__plannotator__plan