ab.minX - 1 && b.maxX <= ab.maxX + 1 && b.minY >= ab.minY - 1 && b.maxY <= ab.maxY + 1 })())\n  for (const part of parts) {\n    const area = areas().find(a => String(a.props.data.label).includes(`· ${part.n} `))\n    const ab = bounds(area.id)\n    const oldH = ab.h\n    editor.deleteShapes(inArea(ab, area.id).map(s => s.id))\n    editor.updateShape({ id: area.id, type: 'mock', props: { data: { label: `nagara · ${part.branch} ${part.branchTitle} · ${part.n} ${part.title} · proposed` } } })\n    const x = ab.minX, y = ab.minY\n    let by = y + 90, cx = x + 40, subW = 0, maxRight = x + 40 + 1160, maxBottom = by\n    const LIMIT = 2600\n    for (const block of part.blocks) {\n      const w = block.kind === 'prose' ? 1160 : undefined\n      let id = block.kind === 'mermaid' ? await mermaid(cx, by, block.text) : text(cx, by, block.text, block.kind === 'mono' ? 'mono' : 'draw', w)\n      await sleep(150)\n      let bb = bounds(id)\n      if (bb.maxY > y + 90 + LIMIT && by > y + 90) { cx = cx + subW + 60; subW = 0; by = y + 90; editor.updateShape({ id, type: editor.getShape(id).type, x: cx, y: by }); await sleep(50); bb = bounds(id) }\n      subW = Math.max(subW, bb.w); maxRight = Math.max(maxRight, bb.maxX); maxBottom = Math.max(maxBottom, bb.maxY); by = bb.maxY + 40\n    }\n    const newH = maxBottom + 60 - y\n    editor.updateShape({ id: area.id, type: 'mock', props: { w: maxRight - x + 40, h: newH } })\n    const delta = newH - oldH\n    if (delta !== 0) {\n      const below = areas().filter(a => a.id !== area.id && Math.abs(bounds(a.id).minX - x) < 5 && bounds(a.id).minY > y)\n      for (const b of below) { const bb2 = bounds(b.id); const kids = inArea(bb2, b.id); editor.updateShapes([b, ...kids].map(s => ({ id: s.id, type: s.type, y: s.y + delta }))) }\n    }\n  }\n  const dangling = editor.getCurrentPageShapes().filter(s => s.type === 'arrow' && editor.getBindingsFromShape(s.id, 'arrow').length < 2)\n  editor.deleteShapes(dangling.map(s => s.id))\n  window.__rd = '