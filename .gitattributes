# Binary fixtures go through Git LFS rather than being stored as plain blobs. A blob committed
# without this in place stays in history at full size even after the file is deleted, and only a
# history rewrite gets it back out.
*.ogg filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
