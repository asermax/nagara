filters:
  and:
    - file.hasTag("experiment")
    - not:
        - file.hasTag("index")
    - not:
        - file.inFolder("_templates")
properties:
  note.started:
    displayName: Started
  file.name:
    displayName: Experiment
  note.status:
    displayName: Status
  note.summary:
    displayName: Answered
  file.mtime:
    displayName: Last updated
views:
  - type: table
    name: Experiments
    order:
      - note.started
      - file.name
      - note.status
      - note.summary
      - file.mtime
    sort:
      - property: note.started
        direction: DESC
