{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nagara",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "worker_loaders": [{ "binding": "LOADER" }],
  "workflows": [{ "name": "item", "binding": "ITEM_WORKFLOW", "class_name": "ItemWorkflow" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nagara",
      "database_id": "bdc5b6b3-724f-47df-8733-640fd263cd2f"
    }
  ],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "nagara" }],
  "images": { "binding": "IMAGES" },
  "durable_objects": {
    "bindings": [{ "name": "DOMAIN_QUEUE", "class_name": "DomainQueue" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DomainQueue", "JobIndex"] },
    { "tag": "flue-class-FlueAuthorAgent", "new_sqlite_classes": ["FlueAuthorAgent"] },
    { "tag": "flue-class-FlueRevisorAgent", "new_sqlite_classes": ["FlueRevisorAgent"] },
    { "tag": "v2", "deleted_classes": ["JobIndex"] }
  ],
  "vars": {
    "agentModel": "cloudflare-ai-gateway/workers-ai/@cf/zai-org/glm-5.3-flash",
    "CLOUDFLARE_ACCOUNT_ID": "2b32439a1d8fdcdf00a9f7f654a11a6d",
    "CLOUDFLARE_GATEWAY_ID": "nagara",
    "agentMaxTurns": 100,
    "authoringRetries": 1,
    "revisionRetries": 2,
    "leaseAlarmMs": 60000,
    "recipeCpuMs": 2000,
    "maxHtmlBytes": 1048576,
    "R2_S3_ENDPOINT": "https://2b32439a1d8fdcdf00a9f7f654a11a6d.r2.cloudflarestorage.com",
    "R2_UPLOAD_ENDPOINT": "https://2b32439a1d8fdcdf00a9f7f654a11a6d.r2.cloudflarestorage.com",
    "R2_BUCKET": "nagara",
    "MODAL_START_URL": "https://asermax--nagara-tts-web.modal.run/start",
    "MODAL_RESULT_URL": "https://asermax--nagara-tts-web.modal.run/result",
    "describeMaxPerItem": 25,
    "imageFetchPerHost": 2,
    "imageFetchConcurrency": 10,
    "pollIntervalSeconds": 5,
    "firecrawlDollarsPerCredit": 0.005,
    "describerDollarsPerCall": 0.0003,
    "ttsDollarsPerSecond": 0.000015
  }
}
