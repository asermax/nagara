# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.ty_cache/

# uv / virtualenvs (uv.lock IS committed; the venv is not)
.venv/
venv/

# Runtime & generated data — SQLite DB, generated audio, experiment fixture dumps
api/data/

# Secrets / local env
.env
.env.*
!.env.example
*.local.env

# Node / web (TanStack Start — for when web/ lands)
node_modules/
dist/
build/
.output/
.nitro/
.vite/
.tanstack/

# OS / editor
.DS_Store
*.swp
.idea/
.vscode/

# Claude Code local settings
.claude/settings.local.json

# Obsidian's per-person workspace/plugin state. _templates/ and _bases/ sit outside this
# directory on purpose, so they are not affected by the ignore and stay checked in.
docs/.obsidian/

# Generated audio never belongs in the repository. Every audio file this project produces is
# output of the TTS pipeline, regenerable for fractions of a cent, and large enough that one
# accidental commit is worth more than the rest of the history put together. Ignored rather
# than routed through LFS, because there is no audio file we would want either way.
*.ogg
*.wav
*.mp3
*.m4a
*.opus
*.flac
